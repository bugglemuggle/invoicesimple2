\f0\fs24 \cf0 const db = new Dexie('InvoiceAppDB');\
db.version(1).stores(\{ invoices: '++id, date, fullSearchText' \});\
\
function switchTab(tab) \{\
  document.getElementById('tab-create').classList.add('hidden');\
  document.getElementById('tab-history').classList.add('hidden');\
  document.getElementById(`tab-$\{tab\}`).classList.remove('hidden');\
  if (tab === 'history') loadHistory();\
\}\
\
async function saveAndShareInvoice() \{\
  const data = \{\
    num: document.getElementById('invNum').value,\
    client: document.getElementById('clientName').value,\
    loc: document.getElementById('clientLoc').value,\
    desc: document.getElementById('invDesc').value,\
    amount: document.getElementById('invAmount').value,\
    date: new Date().toLocaleDateString(),\
  \};\
\
  data.fullSearchText = `$\{data.num\} $\{data.client\} $\{data.loc\} $\{data.desc\}`.toLowerCase();\
  await db.invoices.add(data);\
  await generatePDFAndShare(data);\
  document.querySelectorAll('input').forEach(i => i.value = '');\
  switchTab('history');\
\}\
\
async function generatePDFAndShare(data) \{\
  document.getElementById('pdf-num').innerText = data.num;\
  document.getElementById('pdf-date').innerText = data.date;\
  document.getElementById('pdf-client').innerText = data.client;\
  document.getElementById('pdf-loc').innerText = data.loc;\
  document.getElementById('pdf-desc').innerText = data.desc;\
  document.getElementById('pdf-amount').innerText = `\'a3$\{data.amount\}`;\
\
  const element = document.getElementById('pdf-template');\
  element.classList.remove('hidden');\
\
  const opt = \{\
    margin: 0.5,\
    filename: `Invoice_$\{data.num\}.pdf`,\
    image: \{ type: 'jpeg', quality: 0.98 \},\
    html2canvas: \{ scale: 2 \},\
    jsPDF: \{ unit: 'in', format: 'letter', orientation: 'portrait' \}\
  \};\
\
  const pdfBlob = await html2pdf().set(opt).from(element).output('blob');\
  element.classList.add('hidden');\
\
  const file = new File([pdfBlob], `Invoice_$\{data.num\}.pdf`, \{ type: 'application/pdf' \});\
  \
  if (navigator.canShare && navigator.canShare(\{ files: [file] \})) \{\
    try \{\
      await navigator.share(\{\
        files: [file],\
        title: `Invoice $\{data.num\}`,\
        text: `Here is the invoice for $\{data.desc\}.`\
      \});\
    \} catch (err) \{ console.log('Share canceled'); \}\
  \} else \{\
    alert("Sharing not supported on this browser. File saved to downloads.");\
    const link = document.createElement('a');\
    link.href = URL.createObjectURL(pdfBlob);\
    link.download = `Invoice_$\{data.num\}.pdf`;\
    link.click();\
  \}\
\}\
\
async function loadHistory(query = '') \{\
  const list = document.getElementById('historyList');\
  list.innerHTML = '';\
  const invoices = await db.invoices.reverse().toArray();\
  \
  invoices.forEach(inv => \{\
    if (query && !inv.fullSearchText.includes(query.toLowerCase())) return;\
\
    list.innerHTML += `\
      <div class="bg-white p-4 rounded shadow flex justify-between items-center">\
        <div>\
          <p class="font-bold text-blue-600">$\{inv.num\} <span class="text-sm text-gray-500 ml-2">$\{inv.date\}</span></p>\
          <p class="text-sm font-semibold">$\{inv.client\} - $\{inv.loc\}</p>\
          <p class="text-xs text-gray-600">$\{inv.desc\}</p>\
        </div>\
        <div class="text-right">\
          <p class="font-bold text-lg">\'a3$\{inv.amount\}</p>\
          <button onclick='generatePDFAndShare($\{JSON.stringify(inv)\})' class="text-sm bg-gray-200 px-2 py-1 rounded mt-1">Resend</button>\
        </div>\
      </div>\
    `;\
  \});\
\}\
\
function searchHistory() \{\
  loadHistory(document.getElementById('searchBar').value);\
\}}